# Copy to .env and fill in values. Never commit .env.

# Database — SQLite by default; PostgreSQL in Docker Compose
DATABASE_URL=sqlite:///data/applications.db
# For Docker, set POSTGRES_PASSWORD and DOCKER_DATABASE_URL with the same rotated password.
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=
# DOCKER_DATABASE_URL=postgresql://jobhunter:<URL_ENCODED_PASSWORD>@db:5432/jobhunter

# LLM (optional — matching works without it)
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_ENABLE_EXPLANATIONS=false

# Dashboard
HOST=127.0.0.1
PORT=8000

# Browser assistance
BROWSER_HEADLESS=false
PLAYWRIGHT_HEADLESS=false
LOG_LEVEL=INFO

# User profile (used for forms and matching)
USER_FIRST_NAME=
USER_LAST_NAME=
USER_EMAIL=
USER_PHONE=
USER_PREFERRED_ROLES=python,data engineer,sql
USER_PREFERRED_LOCATIONS=Hyderabad,Bangalore
USER_SALARY_EXPECTATIONS=

# Resume
RESUME_PATH=data/resumes/Satyanarayana_Ryali.pdf
RESUME_SKILLS_PATH=data/resumes/skills.yaml
RESUME_EXPERIENCE_YEARS=5

# Optional job APIs
JOB_COLLECTION_SITES=linkedin,indeed,naukri,glassdoor,google
JOB_COUNTRY=India
JOB_MAX_QUERIES_PER_SOURCE=6
JOB_SOURCE_TIMEOUT=45
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Optional portal logins (never committed). Browser portals are assistance-only.
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
NAUKRI_USERNAME=
NAUKRI_PASSWORD=
INDEED_USERNAME=
INDEED_PASSWORD=

# Optional matching threshold (0-100)
JOB_MIN_MATCH_SCORE=70
APP_AUTO_APPLY=false
